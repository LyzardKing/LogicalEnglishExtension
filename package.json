{
  "name": "logical-english-extension",
  "displayName": "Logical English Extension",
  "description": "Run Logical English programs in VSCode",
  "publisher": "galileos",
  "version": "1.1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/LyzardKing/LogicalEnglishExtension.git"
  },
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Programming Languages",
    "Language Packs"
  ],
  "main": "./out/extension.js",
  "browser": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "logical-english",
        "extensions": [
          ".le"
        ],
        "mimetypes": [
          "text/x-code-output"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "logical-english.italiano",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "logical-english",
        "scopeName": "source.logical-english",
        "path": "./logical-english.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.inline.prolog": "prolog"
        }
      },
      {
        "language": "logical-english.italiano",
        "scopeName": "source.logical-english.italiano",
        "path": "./italiano-logico.tmLanguage.json"
      },
      {
        "language": "prolog",
        "scopeName": "source.prolog",
        "path": "./prolog.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "logical-english-extension.query",
        "title": "Query Logical English",
        "icon": "$(run)"
      },
      {
        "command": "logical-english-extension.query-next",
        "title": "Query Logical English - Next Solution",
        "icon": "$(debug-continue)",
        "enablement": "hasNextSolution"
      },
      {
        "command": "logical-english-extension.show-prolog",
        "title": "Show Prolog - Logical English",
        "icon": "$(debug)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "logical-english-extension.query",
          "group": "navigation",
          "when": "editorLangId == 'logical-english' || editorLangId == 'logical-english.italiano'"
        },
        {
          "command": "logical-english-extension.query-next",
          "group": "navigation",
          "when": "editorLangId == 'logical-english' || editorLangId == 'logical-english.italiano'"
        },
        {
          "command": "logical-english-extension.show-prolog",
          "group": "navigation",
          "when": "editorLangId == 'logical-english' || editorLangId == 'logical-english.italiano'"
        }
      ]
    },
    "configuration": {
      "title": "Logical English",
      "properties": {
        "logicalenglish.pull_pack": {
          "type": "boolean",
          "default": true,
          "description": "Automatically pull the latest le pack if not already installed."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "le_welcome",
        "title": "Welcome to Logical English",
        "description": "Learn how to use Logical English in VSCode",
        "steps": [
          {
            "id": "createfile",
            "title": "Create a Logical English File",
            "description": "Create your first Logical English file by creating a new file with the .le extension.\n[Create a new empty file](command:logical-english-extension.createSplitFileTemplate)\nor\n[open an example file](command:logical-english-extension.createSplitFileDemo)",
            "media": {
              "markdown": "demo/create-file.md"
            },
            "completionEvents": [
              "onCommand:logical-english-extension.createSplitFileTemplate",
              "onCommand:logical-english-extension.createSplitFileDemo"
            ]
          },
          {
            "id": "savefile",
            "title": "Save the File",
            "icon": "$(save)",
            "description": "Save your Logical English file with the `.le` extension to enable syntax highlighting and features.",
            "media": {
              "markdown": "demo/save-file.md"
            }
          },
          {
            "id": "runquery",
            "title": "Run a Query",
            "description": "Run your Logical English queries to see the results.",
            "icon": "$(debug-start)",
            "media": {
              "markdown": "demo/run_query.md"
            }
          },
          {
            "id": "sources",
            "title": "Sources and Documentation",
            "description": "Get more information about Logical English and its features",
            "media": {
              "markdown": "demo/sources.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "webpack": "webpack --config webpack.config.js --mode production",
    "webpack-dev": "webpack --mode development --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "test-compile": "tsc -p ./",
    "package-vsix": "vsce package",
    "run-in-browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. ."
  },
  "devDependencies": {
    "@types/vscode": "^1.103.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@vscode/test-cli": "^0.0.11",
    "eslint": "^9.33.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.9.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "swipl-wasm": "^5.0.18"
  }
}
